    "expo-file-system": "~18.1.11",
    "expo-font": "^55.0.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-pager-view": "^6.9.1",
    "react-native-tab-view": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "@types/xlsx": "^0.0.35",
    "expo-dev-client": "~5.2.4",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3"
  },
